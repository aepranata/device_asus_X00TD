cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.X00TD",
    init_rc: ["fingerprint-X00TD.rc"],
    vintf_fragments: ["fingerprint-X00TD.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "BiometricsFingerprint.cpp",
        "service.cpp",
    ],

    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
        "android.hardware.biometrics.fingerprint-V3-ndk",
        "android.hardware.biometrics.common-V3-ndk",
        "android.hardware.keymaster-V4-ndk",
    ],
    static_libs: [
        "libandroid.hardware.biometrics.fingerprint.VirtualProps",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],

}
