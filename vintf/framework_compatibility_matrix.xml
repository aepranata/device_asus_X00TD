<?xml version="1.0" encoding="utf-8"?>
<!--
    Framework Compatibility Matrix
    Device  : Asus Zenfone Max Pro M1 (X00TD)
    Platform: Qualcomm SDM660
    Type    : framework (HAL requirements declared by the Android framework)
    Format  : HIDL & AIDL

    Semua entry bersifat optional="true" — framework dapat berjalan tanpa HAL
    ini terpenuhi, namun fitur terkait tidak akan tersedia.
-->
<compatibility-matrix version="1.0" type="framework">

    <!-- ================================================================== -->
    <!--  AUDIO                                                               -->
    <!--  HAL untuk pemrosesan audio, efek suara, dan sound trigger          -->
    <!-- ================================================================== -->

    <!-- Primary audio device factory (HIDL) -->
    <hal format="hidl" optional="true">
        <name>android.hardware.audio</name>
        <version>7.0-1</version>
        <interface>
            <name>IDevicesFactory</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Audio effects processing (equalizer, reverb, dsdll) -->
    <hal format="hidl" optional="true">
        <name>android.hardware.audio.effect</name>
        <version>7.0-1</version>
        <interface>
            <name>IEffectsFactory</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Sound trigger / hotword detection (mis. "Hey Google") -->
    <hal format="hidl" optional="true">
        <name>android.hardware.soundtrigger</name>
        <version>2.0-3</version>
        <interface>
            <name>ISoundTriggerHw</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Bluetooth audio provider factory (AIDL) -->
    <hal format="aidl" optional="true">
        <name>android.hardware.bluetooth.audio</name>
        <version>2</version>
        <interface>
            <name>IBluetoothAudioProviderFactory</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Dolby DMS audio post-processing (vendor extension) -->
    <hal format="hidl" optional="true">
        <name>vendor.dolby.hardware.dms</name>
        <version>2.0</version>
        <interface>
            <name>IDms</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- ================================================================== -->
    <!--  BLUETOOTH                                                           -->
    <!--  HAL untuk stack Bluetooth HCI                                      -->
    <!-- ================================================================== -->

    <!-- Bluetooth HCI controller interface -->
    <hal format="hidl" optional="true">
        <name>android.hardware.bluetooth</name>
        <version>1.0-1</version>
        <interface>
            <name>IBluetoothHci</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- ANT+ wireless protocol (mis. sensor fitness) -->
    <hal format="hidl" optional="true">
        <name>com.dsi.ant</name>
        <version>1.0</version>
        <interface>
            <name>IAnt</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- QTI Bluetooth SAR power control -->
    <hal format="hidl" optional="true">
        <name>vendor.qti.hardware.bluetooth_sar</name>
        <version>1.0-1</version>
        <interface>
            <name>IBluetoothSar</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- QTI Bluetooth config store (firmware/config parameters) -->
    <hal format="hidl" optional="true">
        <name>vendor.qti.hardware.btconfigstore</name>
        <version>2.0</version>
        <interface>
            <name>IBTConfigStore</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- ================================================================== -->
    <!--  CAMERA                                                              -->
    <!--  HAL untuk akses kamera hardware                                    -->
    <!-- ================================================================== -->

    <!-- Camera provider (legacy HAL1 backward-compat via legacy/0) -->
    <hal format="hidl" optional="true">
        <name>android.hardware.camera.provider</name>
        <version>2.4</version>
        <interface>
            <name>ICameraProvider</name>
            <instance>legacy/0</instance>
        </interface>
    </hal>

    <!-- ================================================================== -->
    <!--  CODEC / MEDIA                                                       -->
    <!--  HAL untuk encode/decode media (OMX, Codec 2.0) dan DRM/CAS        -->
    <!-- ================================================================== -->

    <!-- Conditional Access System (CAS) untuk konten terproteksi (AIDL) -->
    <hal format="aidl" optional="true">
        <name>android.hardware.cas</name>
        <interface>
            <name>IMediaCasService</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Conditional Access System (CAS) versi HIDL -->
    <hal format="hidl" optional="true">
        <name>android.hardware.cas</name>
        <version>1.2</version>
        <interface>
            <name>IMediaCasService</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- DRM factory untuk ClearKey (open standard, AIDL) -->
    <hal format="aidl" optional="true">
        <name>android.hardware.drm</name>
        <version>1</version>
        <interface>
            <name>IDrmFactory</name>
            <instance>clearkey</instance>
        </interface>
    </hal>

    <!-- DRM factory + crypto untuk Widevine (Google DRM, HIDL) -->
    <hal format="hidl" optional="true">
        <name>android.hardware.drm</name>
        <version>1.3</version>
        <interface>
            <name>IDrmFactory</name>
            <instance>widevine</instance>
        </interface>
        <interface>
            <name>ICryptoFactory</name>
            <instance>widevine</instance>
        </interface>
    </hal>

    <!-- OpenMAX IL media codec (legacy encoder/decoder) -->
    <hal format="hidl" optional="true">
        <name>android.hardware.media.omx</name>
        <version>1.0</version>
        <interface>
            <name>IOmx</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IOmxStore</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Codec 2.0 component store (hardware + software decoder/encoder) -->
    <hal format="hidl" optional="true">
        <name>android.hardware.media.c2</name>
        <version>1.0</version>
        <version>1.2</version>
        <interface>
            <name>IComponentStore</name>
            <instance>default</instance>
            <instance>software</instance>
        </interface>
    </hal>

