on early-boot
    # Backlight devices
    chown system system /sys/class/backlight/backlight/brightness
    chown system system /sys/class/backlight/backlight/max_brightness

    chown system system /sys/class/backlight/panel0-backlight/brightness
    chown system system /sys/class/backlight/panel0-backlight/max_brightness

    # LED devices
    chown system system /sys/class/leds/blue/breath
    chown system system /sys/class/leds/blue/brightness
    chown system system /sys/class/leds/blue/max_brightness
    chown system system /sys/class/leds/blue/power
    chown system system /sys/class/leds/blue/trigger
    chown system system /sys/class/leds/blue/uevent

    chown system system /sys/class/leds/blue:status/breath
    chown system system /sys/class/leds/blue:status/brightness
    chown system system /sys/class/leds/blue:status/max_brightness
    chown system system /sys/class/leds/blue:status/power
    chown system system /sys/class/leds/blue:status/trigger
    chown system system /sys/class/leds/blue:status/uevent

    chown system system /sys/class/leds/green/breath
    chown system system /sys/class/leds/green/brightness
    chown system system /sys/class/leds/green/max_brightness
    chown system system /sys/class/leds/green/power
    chown system system /sys/class/leds/green/trigger
    chown system system /sys/class/leds/green/uevent

    chown system system /sys/class/leds/green:status/breath
    chown system system /sys/class/leds/green:status/brightness
    chown system system /sys/class/leds/green:status/max_brightness
    chown system system /sys/class/leds/green:status/power
    chown system system /sys/class/leds/green:status/trigger
    chown system system /sys/class/leds/green:status/uevent

    chown system system /sys/class/leds/lcd-backlight/brightness
    chown system system /sys/class/leds/lcd-backlight/max_brightness
    chown system system /sys/class/leds/lcd-backlight/power
    chown system system /sys/class/leds/lcd-backlight/trigger
    chown system system /sys/class/leds/lcd-backlight/uevent

    chown system system /sys/class/leds/red/breath
    chown system system /sys/class/leds/red/brightness
    chown system system /sys/class/leds/red/max_brightness
    chown system system /sys/class/leds/red/power
    chown system system /sys/class/leds/red/trigger
    chown system system /sys/class/leds/red/uevent

    chown system system /sys/class/leds/red:status/breath
    chown system system /sys/class/leds/red:status/brightness
    chown system system /sys/class/leds/red:status/max_brightness
    chown system system /sys/class/leds/red:status/power
    chown system system /sys/class/leds/red:status/trigger
    chown system system /sys/class/leds/red:status/uevent

service vendor.light-default /vendor/bin/hw/android.hardware.light-service.asus_X00TD
    class hal
    user system
    group system
    shutdown critical
