cc_binary {
    name: "android.hardware.light-service.asus_X00TD",
    defaults: ["hidl_defaults"],
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.light-service.asus_X00TD.rc"],
    vintf_fragments: ["android.hardware.light-service.asus_X00TD.xml"],

    srcs: [
        "devices/BacklightDevice.cpp",
        "devices/LedDevice.cpp",
        "devices/RgbLedDevice.cpp",
        "models/Color.cpp",
        "models/State.cpp",
        "Devices.cpp",
        "Lights.cpp",
        "Utils.cpp",
        "service.cpp",
    ],

    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "android.hardware.light-V2-ndk",
    ],
}
